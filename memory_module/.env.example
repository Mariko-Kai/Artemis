# Environment variables for Memory Module
# Copy this file to .env and configure as needed

# Embedding Configuration
MM_EMBEDDING_MODEL_NAME=Snowflake/snowflake-arctic-embed-m
MM_EMBEDDING_DEVICE=cpu
MM_VECTOR_DIM=768
MM_BATCH_SIZE=32

# Database Configuration
MM_DATABASE_URL=sqlite+aiosqlite:///./memory_module/memory.db

# Vector Store Configuration
MM_FAISS_INDEX_PATH=./memory_module/faiss_index
MM_FAISS_INDEX_TYPE=Flat

# Redis Configuration (optional)
# MM_REDIS_URL=redis://localhost:6379
MM_CACHE_TTL=3600

# Search Configuration
MM_DEFAULT_TOP_K=10
MM_MAX_TOP_K=100
MM_DEFAULT_HYBRID_WEIGHT=0.5

# API Configuration
MM_API_HOST=0.0.0.0
MM_API_PORT=8001
MM_API_RELOAD=false
MM_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Logging Configuration
MM_LOG_LEVEL=INFO

# Worker Configuration
MM_ENABLE_BACKGROUND_WORKERS=true
MM_WORKER_QUEUE_SIZE=100

# Performance Configuration
MM_MAX_CONCURRENT_REQUESTS=10

# Alternative: Use YAML config file
# MM_CONFIG_PATH=./memory_module/config/config.yaml
